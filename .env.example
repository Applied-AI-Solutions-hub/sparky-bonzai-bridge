# Copy to .env and adjust. Every value is optional; these are the defaults.

# Listen address. Keep loopback: Tailscale Serve is the only way in.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8795

# How Sparky and the phone model refer to you, e.g. your first name.
BRIDGE_OWNER_NAME=the owner

# OpenClaw
OPENCLAW_BIN=openclaw
# Use a restricted agent for phone turns (see docs/openclaw-setup.md).
OPENCLAW_AGENT=main

# How long sparky_ask waits before returning a job id instead of an answer.
BRIDGE_ASK_WAIT_SECONDS=75
# Hard cap for one Sparky turn.
BRIDGE_TURN_TIMEOUT_SECONDS=900
BRIDGE_MAX_ASKS_PER_HOUR=40

# Paths (~ is expanded)
BRIDGE_DEVICES_FILE=~/.config/sparky-bonzai-bridge/devices.json
BRIDGE_STATE_DIR=~/.local/state/sparky-bonzai-bridge
BRIDGE_SPARKY_INBOX_DIR=~/workspace/inbox/bonzai
BRIDGE_OUTBOX_DIR=~/workspace/outbox/bonzai
