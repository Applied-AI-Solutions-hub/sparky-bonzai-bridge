{
  "name": "sparky-bonzai-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MCP bridge that lets the BonzAI app on iPhone/iPad hand work to Sparky, an OpenClaw agent on a home PC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "device": "node --env-file-if-exists=.env scripts/device.ts",
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  }
}
